# Copy to `.env` if you need any of the optional settings below. docker compose
# loads it automatically. Nothing here is required.
#
# MODELS are NOT configured here any more: servers, models and the brain/vision roles
# live in config/models/models.yml, managed by the "model configuration" entry of the
# session menu in the browser terminal (or hand-edit the file — see
# config/models/models.example.yml). Changes apply without restarting anything.

# ----- Other ------------------------------------------------------------------
# Default tool at browser connect (claude | opencode | omp); empty = menu
#DEFAULT_TOOL=

# ----- Headroom (optional context-compression sidecar, issue #11) --------------
# Enable both lines together (litellm -> headroom -> reasoning-normalizer -> vLLM);
# details + gates: ideas/headroom-spike-results.md
#COMPOSE_PROFILES=headroom
#LITELLM_BRAIN_URL=http://agentic-headroom:8787/v1

# ----- Build speed -------------------------------------------------------------
# apt mirror for image builds (full URL incl. /ubuntu/); pick one close to you.
# https works: the Dockerfile bootstraps ca-certificates from the stock archive first.
#APT_MIRROR=https://mirror.netcologne.de/ubuntu/
