# Copy to `.env` if you need any of the optional settings below. docker compose loads it
# automatically.
#
# Models are NOT configured here — copy config/models.example.json to config/models.json and
# list your actual server(s)/node(s) and model(s) there. See README.md.

# ----- Legacy fallback (only used if config/models.json is missing) ------------
# A single fixed inference server. Once config/models.json exists, this is ignored.
#VLLM_UPSTREAM=http://10.0.0.25:8888/v1

# ----- Headroom (optional context-compression sidecar, issue #11) --------------
# Enable both lines together (litellm -> headroom -> reasoning-normalizer -> vLLM);
# details + gates: ../ideas/headroom-spike-results.md
#COMPOSE_PROFILES=headroom
#LITELLM_BRAIN_URL=http://agentic-headroom:8787/v1
